{
  "name": "obsidian-linker",
  "displayName": "Obsidian Linker",
  "description": "Obsidian-style [[wikilinks]] for VS Code: Ctrl/Cmd+Click to open notes (new tab / split), hover actions, and open the current file in Obsidian.",
  "version": "0.1.3",
  "publisher": "Moy",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moyf/vsc-obsidian-linker"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wikilink",
    "obsidian",
    "zettelkasten"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Obsidian Linker",
      "properties": {
        "obsidian-linker.openMode": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "newTab",
            "split"
          ],
          "enumDescriptions": [
            "VS Code default: opens in the current editor group (may reuse a preview tab)",
            "Opens a pinned (non-preview) tab in the current editor group",
            "Opens in a split editor to the right"
          ],
          "description": "How [[wikilinks]] are opened (applies to Ctrl/Cmd+Click, the command, and hover buttons). Reopen the file or edit it once after changing this setting."
        },
        "obsidian-linker.vaultName": {
          "type": "string",
          "default": "",
          "description": "Optional Obsidian vault name used by 'Open in Obsidian'. When empty, Obsidian resolves the vault from the absolute path automatically."
        }
      }
    },
    "commands": [
      {
        "command": "obsidian-linker.open",
        "title": "Obsidian Linker: Open Note Under Cursor",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "obsidian-linker.openInObsidian",
        "title": "Obsidian Linker: Open Current File in Obsidian",
        "icon": "$(book)",
        "enablement": "resourceLangId == markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceLangId == markdown",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceLangId == markdown",
          "group": "wikilink@1"
        }
      ],
      "commandPalette": [
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "obsidian-linker.open",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "obsidian-linker.open",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "check": "tsc --noEmit",
    "test": "node ./esbuild.js --tests && node --test out-test/test/wikilink.test.js",
    "package": "node ./esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
