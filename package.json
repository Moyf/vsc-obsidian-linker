{
  "name": "obsidian-linker",
  "displayName": "Obsidian Linker",
  "description": "Obsidian-style [[wikilinks]] for VS Code: Ctrl/Cmd+Click to open notes (new tab / split), hover actions, and open the current file in Obsidian.",
  "version": "0.1.7",
  "publisher": "Moy",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Moyf/vsc-obsidian-linker"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wikilink",
    "obsidian",
    "zettelkasten"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "configuration": {
      "title": "Obsidian Linker",
      "properties": {
        "obsidian-linker.openMode": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "newTab",
            "split"
          ],
          "enumDescriptions": [
            "VS Code default: opens in the current editor group (may reuse a preview tab)",
            "Opens a pinned (non-preview) tab in the current editor group",
            "Opens in a split editor to the right"
          ],
          "description": "How [[wikilinks]] are opened (applies to Ctrl/Cmd+Click, the command, and hover buttons). Reopen the file or edit it once after changing this setting."
        },
        "obsidian-linker.vaultName": {
          "type": "string",
          "default": "",
          "description": "Optional Obsidian vault name or ID used by 'Open in Obsidian'. May be omitted for both vault files and standalone files (Obsidian 1.14.2+)."
        },
        "obsidian-linker.indexOnlyMarkdown": {
          "type": "boolean",
          "default": false,
          "description": "Index only Markdown (.md) files. Saves memory for large vaults, but wikilinks to images, PDFs, canvases, etc. will no longer resolve."
        },
        "obsidian-linker.indexExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns of files/folders to exclude from the index, relative to the workspace folder (e.g. [\".trash/**\", \"attachments/archive/**\"]). Can be set per project in .vscode/settings.json. The index rebuilds automatically when this changes."
        },
        "obsidian-linker.indexLimit": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum number of files to index. 0 (default) means no limit: every file is indexed and memory usage grows with vault size (roughly 1KB per file). If a limit is set and the vault has more files, files beyond the limit are NOT indexed and their wikilinks will show \"Note not found\"."
        }
      }
    },
    "commands": [
      {
        "command": "obsidian-linker.previewOpenInNewTab",
        "title": "Open Link in New Tab"
      },
      {
        "command": "obsidian-linker.previewOpenToSide",
        "title": "Open Link to the Side"
      },
      {
        "command": "obsidian-linker.previewCopyLink",
        "title": "Copy Link Address"
      },
      {
        "command": "obsidian-linker.open",
        "title": "Obsidian Linker: Open Note Under Cursor",
        "enablement": "editorLangId == markdown"
      },
      {
        "command": "obsidian-linker.openInObsidian",
        "title": "Open in Obsidian",
        "icon": "$(ruby)",
        "enablement": "resourceScheme == file"
      },
      {
        "command": "obsidian-linker.openCurrentInObsidian",
        "title": "Open Current File in Obsidian",
        "icon": "$(ruby)",
        "enablement": "resourceScheme == file"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "obsidian-linker.previewOpenInNewTab",
          "when": "(webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor') && webviewSection == 'obsidianWikilink'",
          "group": "navigation@1"
        },
        {
          "command": "obsidian-linker.previewOpenToSide",
          "when": "(webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor') && webviewSection == 'obsidianWikilink'",
          "group": "navigation@2"
        },
        {
          "command": "obsidian-linker.previewCopyLink",
          "when": "(webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor') && webviewSection == 'obsidianWikilink'",
          "group": "clipboard@1"
        }
      ],
      "explorer/context": [
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@-100"
        }
      ],
      "editor/title": [
        {
          "command": "obsidian-linker.openCurrentInObsidian",
          "when": "resourceLangId == markdown",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceLangId == markdown",
          "group": "navigation@-100"
        }
      ],
      "commandPalette": [
        { "command": "obsidian-linker.previewOpenInNewTab", "when": "false" },
        { "command": "obsidian-linker.previewOpenToSide", "when": "false" },
        { "command": "obsidian-linker.previewCopyLink", "when": "false" },
        {
          "command": "obsidian-linker.openInObsidian",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "obsidian-linker.openCurrentInObsidian",
          "when": "false"
        },
        {
          "command": "obsidian-linker.open",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "obsidian-linker.open",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "check": "tsc --noEmit",
    "test": "node ./esbuild.js --tests && node --test out-test/test/*.test.js",
    "test:host": "node ./esbuild.js --tests && node scripts/test-host.cjs",
    "package": "node ./esbuild.js --production",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/github-slugger": "^1.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.23.1",
    "github-slugger": "^1.5.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.5.4"
  }
}
